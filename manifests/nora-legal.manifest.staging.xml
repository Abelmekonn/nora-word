<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
  xsi:type="TaskPaneApp">

  <!-- STAGING manifest (pilot / internal users) -->
  <!-- Different ID from PROD so it can be installed side-by-side -->
  <Id>a2b6c8b3-6d80-4f3f-8d0f-05f9e6e7f6b4</Id>
  <Version>1.0.0.0</Version>

  <ProviderName>WeQuity</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>

  <DisplayName DefaultValue="Nora Legal (Staging)"/>
  <Description DefaultValue="Staging build of Nora Legal for pilot users and QA."/>

  <IconUrl DefaultValue="https://nora-word-jet.vercel.app/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://nora-word-jet.vercel.app/assets/icon-80.png"/>

  <SupportUrl DefaultValue="https://wequity.io/support"/>

  <AppDomains>
    <AppDomain>https://nora-word-jet.vercel.app</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Document"/>
  </Hosts>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://nora-word-jet.vercel.app/taskpane.html"/>
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides
    xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
    xsi:type="VersionOverridesV1_0">

    <Hosts>
      <Host xsi:type="Document">

        <!-- ===== Desktop ===== -->
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url"/>

          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="NoraLegalGroup">
                <Label resid="GroupLabel"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>

                <Control xsi:type="Button" id="TaskpaneButton">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.Label"/>
                    <Description resid="TaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>NoraTaskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>

                <!-- OPTIONAL – keep only if implemented -->
                <Control xsi:type="Button" id="QuickDraftButton">
                  <Label resid="QuickDraftButton.Label"/>
                  <Supertip>
                    <Title resid="QuickDraftButton.Label"/>
                    <Description resid="QuickDraftButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>quickDraft</FunctionName>
                  </Action>
                </Control>

              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>

        <!-- ===== Word on Web ===== -->
        <WebFormFactor>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="NoraLegalGroup">
                <Label resid="GroupLabel"/>
                <Control xsi:type="Button" id="TaskpaneButtonWeb">
                  <Label resid="TaskpaneButton.Label"/>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>NoraTaskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </WebFormFactor>

      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://nora-word-jet.vercel.app/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://nora-word-jet.vercel.app/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://nora-word-jet.vercel.app/assets/icon-80.png"/>
      </bt:Images>

      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://nora-word-jet.vercel.app/commands.html"/>
        <bt:Url id="Taskpane.Url" DefaultValue="https://nora-word-jet.vercel.app/taskpane.html"/>
      </bt:Urls>

      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="Nora Legal"/>
        <bt:String id="TaskpaneButton.Label" DefaultValue="Open Nora"/>
        <bt:String id="QuickDraftButton.Label" DefaultValue="Quick Draft"/>
      </bt:ShortStrings>

      <bt:LongStrings>
        <bt:String id="TaskpaneButton.Tooltip"
          DefaultValue="Open the Nora Legal AI assistant (Staging)."/>
        <bt:String id="QuickDraftButton.Tooltip"
          DefaultValue="Quickly draft content at the cursor using AI."/>
      </bt:LongStrings>
    </Resources>

  </VersionOverrides>
</OfficeApp>
