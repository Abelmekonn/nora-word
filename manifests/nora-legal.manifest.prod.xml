<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
           xsi:type="TaskPaneApp">

  <!-- PRODUCTION manifest (customer deployment) -->
  <!-- IMPORTANT: keep this Id stable once customers deploy it. -->
  <Id>f4e85b12-7c5a-4d3f-9e6b-8a2c1d0f5e4b</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>WeQuity</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Nora Legal"/>
  <Description DefaultValue="AI-powered legal assistant for drafting, reviewing, and improving documents directly in Microsoft Word."/>

  <IconUrl DefaultValue="https://word.noralegal.com/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://word.noralegal.com/assets/icon-80.png"/>

  <SupportUrl DefaultValue="https://wequity.io/support"/>
  <PrivacyUrl DefaultValue="https://wequity.io/privacy"/>

  <AppDomains>
    <AppDomain>https://word.noralegal.com</AppDomain>
    <!-- Optional: include Supabase/Auth redirect origins if you navigate during auth -->
    <!-- <AppDomain>https://REPLACE-WITH-SUPABASE-PROJECT.supabase.co</AppDomain> -->
    <!-- Optional: include AI worker host if you open it in a new window -->
    <!-- <AppDomain>https://REPLACE-WITH-AI-WORKER-HOST</AppDomain> -->
  </AppDomains>

  <Hosts>
    <Host Name="Document"/>
  </Hosts>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://word.noralegal.com/taskpane.html"/>
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url"/>

          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="NoraLegalGroup">
                <Label resid="GroupLabel"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>

                <Control xsi:type="Button" id="TaskpaneButton">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.Label"/>
                    <Description resid="TaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ButtonId1</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
        <WebFormFactor>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="NoraLegalGroup">
                <Label resid="GroupLabel"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>
                <Control xsi:type="Button" id="TaskpaneButton">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.Label"/>
                    <Description resid="TaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ButtonId1</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </WebFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://word.noralegal.com/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://word.noralegal.com/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://word.noralegal.com/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://word.noralegal.com/commands.html"/>
        <bt:Url id="Taskpane.Url" DefaultValue="https://word.noralegal.com/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="Nora Legal"/>
        <bt:String id="TaskpaneButton.Label" DefaultValue="Open Nora"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Open the Nora Legal AI assistant for drafting, redlining, and compliance."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
